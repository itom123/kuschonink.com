---
// The taskbar: Start, Quick Launch, a button per open window, the tray.
import StartMenu from './StartMenu.astro';
---
<footer class="taskbar" id="k98-taskbar" aria-label="Taskbar">
  <StartMenu />
  <span class="tb-etch ql" aria-hidden="true"></span>
  <span class="tb-handle ql" aria-hidden="true"></span>
  <div class="tb-group quick-launch" role="toolbar" aria-label="Quick Launch">
    <button type="button" class="ql-btn" data-cmd="show-desktop" data-js-only title="Show Desktop" aria-label="Show Desktop"><span class="ico ico16 ico-desktop" aria-hidden="true"></span></button>
    <a class="ql-btn" href="/house/facade" title="The House" aria-label="The House"><span class="ico ico16 ico-house" aria-hidden="true"></span></a>
    <a class="ql-btn" href="/image" title="Projects" aria-label="Projects"><span class="ico ico16 ico-folder" aria-hidden="true"></span></a>
  </div>
  <span class="tb-etch" aria-hidden="true"></span>
  <span class="tb-handle" aria-hidden="true"></span>
  <div class="tasks" id="k98-tasks" role="toolbar" aria-label="Open windows"></div>
  <div class="tray" id="k98-tray" data-js-only>
    <button type="button" class="tray-btn" id="k98-volume" aria-label="Volume"><span class="ico ico16 ico-speaker" aria-hidden="true"></span></button>
    <time class="clock" id="k98-clock"></time>
  </div>
</footer>
