---
// Renders a menu (and its cascading submenus) as nested lists of real links,
// so menus work as plain navigation without JavaScript.
import { accelKey, biAccelHtml, plainLabel, type MenuItem } from '../../lib/menus';
import { attr } from '../../lib/i18n';

interface Props { items: MenuItem[]; class?: string; label?: string; labelZh?: string }
const { items, class: className, label, labelZh } = Astro.props;
/** aria-label in both languages (src/scripts/lang.ts swaps it). */
const aria = (en?: string, zh?: string) => (en ? attr('aria-label', { en: plainLabel(en), zh: plainLabel(zh ?? '') }) : {});
---
<ul class:list={['menu', className]} role="menu" {...aria(label, labelZh)}>
  {items.map((it) =>
    it.sep ? (
      <li class="menu-sep" role="separator" data-js-only={it.jsOnly ? '' : undefined}></li>
    ) : (
      <li class:list={{ 'has-sub': !!it.sub }} role="none" data-js-only={it.jsOnly ? '' : undefined}>
        {it.href ? (
          <a
            class:list={['menu-item', { big: it.big }]}
            role="menuitem"
            href={it.href}
            target={it.external ? '_blank' : undefined}
            rel={it.external ? 'noopener' : undefined}
            data-key={accelKey(it.label)}
            aria-haspopup={it.sub ? 'menu' : undefined}
            aria-expanded={it.sub ? 'false' : undefined}
            aria-disabled={it.disabled ? 'true' : undefined}
            {...aria(it.label, it.zh)}
            {...it.attrs}
          >
            {it.icon && <span class:list={['ico', it.big ? '' : 'ico16', `ico-${it.icon}`]} aria-hidden="true"></span>}
            <span class="mi-label" set:html={biAccelHtml(it.label ?? '', it.zh)} />
            {it.key && <span class="mi-key">{it.key}</span>}
          </a>
        ) : (
          <button
            type="button"
            class:list={['menu-item', { big: it.big }]}
            role="menuitem"
            data-cmd={it.cmd}
            data-key={accelKey(it.label)}
            aria-haspopup={it.sub ? 'menu' : undefined}
            aria-expanded={it.sub ? 'false' : undefined}
            aria-disabled={it.disabled ? 'true' : undefined}
            {...aria(it.label, it.zh)}
            {...it.attrs}
          >
            {it.icon && <span class:list={['ico', it.big ? '' : 'ico16', `ico-${it.icon}`]} aria-hidden="true"></span>}
            <span class="mi-label" set:html={biAccelHtml(it.label ?? '', it.zh)} />
            {it.key && <span class="mi-key">{it.key}</span>}
          </button>
        )}
        {it.sub && <Astro.self items={it.sub} class="sub" label={it.label} labelZh={it.zh} />}
      </li>
    ),
  )}
</ul>
