---
// The icons on the desktop. Links open their page (or, with JavaScript, a
// window); buttons open programs that only exist in the browser.
import { DESK_ICONS } from '../../lib/desktop';
---
<ul class="desktop-icons" id="desktop-icons" aria-label="Desktop">
  {DESK_ICONS.map((i) => (
    <li class="desk-item" data-js-only={i.open ? '' : undefined}>
      {i.href ? (
        <a
          class="icon"
          id={`icon-${i.id}`}
          href={i.href}
          target={i.external ? '_blank' : undefined}
          rel={i.external ? 'noopener' : undefined}
          data-icon-id={i.id}
          data-tip={i.tip}
          data-type={i.type}
          draggable="false"
        >
          <span class={`ico ico-${i.icon}`} aria-hidden="true">{i.shortcut && <span class="ico ico-shortcut"></span>}</span>
          <span class="icon-label">{i.label}</span>
        </a>
      ) : (
        <button type="button" class="icon" id={`icon-${i.id}`} data-open={i.open} data-icon-id={i.id} data-tip={i.tip} data-type={i.type}>
          <span class={`ico ico-${i.icon}`} aria-hidden="true"></span>
          <span class="icon-label">{i.label}</span>
        </button>
      )}
    </li>
  ))}
</ul>
