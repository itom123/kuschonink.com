---
// The Start button and its menu. Every item that can be a link is one, so
// the menu works without JavaScript (submenus open on hover/focus).
import MenuList from './MenuList.astro';
import { projects, site } from '../../lib/content';
import type { MenuItem } from '../../lib/menus';

const amp = (s: string) => s.replace(/&/g, '&&');
const projectItems: MenuItem[] = projects.map((p) => ({ label: amp(p.title), href: `/image/${p.slug}`, icon: 'folder' }));

const items: MenuItem[] = [
  { label: '&Instagram', href: site.social[0].href, external: true, icon: 'camera', big: true },
  { sep: true },
  {
    label: '&Programs', href: '/image', icon: 'programs', big: true,
    sub: [
      { label: '&Projects', href: '/image', icon: 'folder', sub: [...projectItems, { sep: true }, { label: '&All projects on one page', href: '/image/all', icon: 'documents' }] },
      {
        label: 'The &House', href: '/house', icon: 'house',
        sub: [
          { label: '&Floorplan', href: '/house', icon: 'house' },
          { sep: true },
          { label: '&Index', href: '/house/appendix/index', icon: 'topic' },
          { label: '&Chronology', href: '/house/appendix/chronology', icon: 'topic' },
          { label: 'Check&list of the chapters', href: '/house/appendix/checklist', icon: 'topic' },
          { label: '&Rules of the house', href: '/house/appendix/rules', icon: 'topic' },
        ],
      },
      { label: '&About.doc', href: '/about', icon: 'document' },
      { label: '&Contact', href: '/contact', icon: 'mail' },
    ],
  },
];
---
<details class="start" id="start">
  <summary class="start-button" aria-label="Start" title="Click here to begin">
    <span class="ico ico16 ico-start" aria-hidden="true"></span><span class="start-label">Start</span>
  </summary>
  <div class="start-menu" id="start-menu">
    <div class="start-banner" aria-hidden="true"><span><b>kuschonink</b>98</span></div>
    <MenuList items={items} class="start-list" label="Start menu" />
  </div>
</details>
