---
import Section from '../Section.astro';
import { projects, about, contact, site } from '../../lib/content';
import { neighbours, house, rooms, type Room } from '../../lib/house';

interface Props { room: Room }
const { room } = Astro.props;
const { prev, next } = neighbours(room);
const c = room.contents;
const project = c && 'project' in c ? projects.find((p) => p.slug === c.project) : undefined;
const page = c && 'page' in c ? c.page : undefined;
const sections = project?.sections ?? (page === 'about' ? about.sections : page === 'contact' ? contact.sections : []);
const chapterLabel = (r: Room) => (r.locked ? 'Chapter —' : `Chapter ${r.chapter}`);
---
<aside class="room-panel" data-room-page={room.slug} aria-labelledby="room-title">
  <div class="panel-bar">
    <span>{chapterLabel(room)} · {room.floor.name} · {room.floor.zh}</span>
    <a class="panel-close" href={`/house?floor=${room.floor.id}`} aria-label="Close and return to the floorplan">[×]</a>
  </div>
  <div class="panel-body">
    <h1 id="room-title">{room.title}</h1>
    <p class="room-name">{room.zh && <span lang="zh">{room.zh}</span>} {room.en}</p>

    <p class="inventory"><b>Inventory:</b> {room.inventory.join('; ')}.</p>

    <details class="constraints" open={!room.contents ? true : undefined}>
      <summary>Constraints for chapter {room.locked ? '—' : room.chapter}</summary>
      <table>
        <thead><tr><th scope="col">List</th><th scope="col">Value</th><th scope="col">Status</th></tr></thead>
        <tbody>
          {room.constraints.map((c) => (
            <tr class:list={{ hidden: c.hidden }} data-status={c.status}>
              <th scope="row">{c.name}</th>
              <td>{c.value}</td>
              <td>{c.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="constraints-note">Hidden constraints in red. <a href="/house/appendix/rules">How the constraints are dealt</a>.</p>
    </details>
    <hr />

    {room.locked && (
      <div class="missing">
        <p><i>This chapter is missing.</i></p>
        <p>{house.lockedNote}</p>
      </div>
    )}

    {sections.map((s, i) => <Section section={s} first={i === 0} />)}

    {page === 'writings' && (
      <p><i>The writings will be kept here.</i></p>
    )}

    {page === 'colophon' && (
      <div class="prose">
        <p>{site.name}. <a href="/">kuschonink.com</a></p>
        <p>The house is drawn from the plans of the 2008 renovation of the family house: ground floor, first floor, attic and roof, and the south elevation. {house.lockedNote}</p>
        <p>Its {rooms.length} chapters follow a knight’s tour of the house’s 5 × 5 structural grid, floor by floor, after Georges Perec’s <i>Life A User’s Manual</i> (1978). One room has no door.</p>
        <p>The house collects: every room keeps one thing. The <a href="/image">simple view</a> classifies the same things into an array.</p>
        <p>Appendices: <a href="/house/appendix/index">Index</a> · <a href="/house/appendix/chronology">Chronology</a> · <a href="/house/appendix/checklist">Checklist</a> · <a href="/house/appendix/rules">Rules</a>.</p>
        <p>Set in Times New Roman.</p>
      </div>
    )}

    {project && (
      <p class="simple-link"><a href={`/image/${project.slug}`}>See “{project.title}” in the simple view</a></p>
    )}
    {page === 'about' && <p class="simple-link"><a href="/about">About, in the simple view</a></p>}
    {page === 'contact' && <p class="simple-link"><a href="/contact">Contact, in the simple view</a></p>}

    <hr />
    <nav class="chapter-nav" aria-label="Chapters">
      {prev ? <a href={`/house/${prev.slug}`} rel="prev">← {chapterLabel(prev)}: {prev.title}</a> : <span />}
      {next ? <a href={`/house/${next.slug}`} rel="next">{chapterLabel(next)}: {next.title} →</a> : <a href="/house/appendix/index" rel="next">Appendices: Index →</a>}
    </nav>
  </div>
</aside>
