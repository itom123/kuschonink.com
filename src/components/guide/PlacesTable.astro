---
// Field Guide: the Places pane. One list at every width, two columns: the ref
// with its tier icon, then the name, the artist and title, and a small line
// with the distinction and price level (a guide that has them), the opening
// days (or the chosen day's status) and the area. "Sort by:"
// orders it; JS also fills the day, moves the places closed on the chosen day
// into their own group and filters by theme and Find (src/scripts/guide/
// panes.ts, order.ts). Without JS it lists everything, in the guide's order.
import Bi from '../Bi.astro';
import { attr, text } from '../../lib/i18n';
import { biAccelHtml } from '../../lib/menus';
import { normalise } from '../../lib/guides/core';
import { W, lowerFirst, weekPattern } from '../../lib/guides/words';
import type { Bi as BiT, GuideView } from '../../lib/guides/types';

interface Props { view: GuideView }
const { view } = Astro.props;
const zone = (id: string) => view.zones.find((z) => z.id === id)?.name ?? { en: id, zh: '' };
// The Area order follows the guide's own list of areas.
const zoneAt = (id: string) => { const i = view.zones.findIndex((z) => z.id === id); return i < 0 ? view.zones.length : i; };
const theme = (id: string) => view.themes.find((t) => t.id === id)?.name ?? { en: id, zh: '' };
// The Price order follows the guide's own list of levels (cheapest first).
const costAt = (id?: string) => { const i = id ? view.costs.findIndex((c) => c.id === id) : -1; return i < 0 ? undefined : i; };
const costOf = (id?: string) => (id ? view.costs.find((c) => c.id === id) : undefined);
const awardOf = (id?: string) => (id ? view.awards.find((a) => a.id === id) : undefined);
/** The marks before the days and area: "★★ €€€€". */
const marks = (it: { award?: string; cost?: string }): BiT | null => {
  const a = awardOf(it.award), c = costOf(it.cost);
  if (!a && !c) return null;
  return { en: [a?.short.en, c?.name.en].filter(Boolean).join(' '), zh: [a ? a.short.zh || a.short.en : '', c ? c.name.zh || c.name.en : ''].filter(Boolean).join(' ') };
};
const category = (id: string) => view.categories.find((c) => c.id === id)?.name ?? { en: id, zh: '' };
const both = (t: BiT) => `${t.en} ${t.zh}`;
const q = (...parts: string[]) => normalise(parts.filter(Boolean).join(' '));
const loose = view.listings.records.filter((r) => !r.item);
const hasDays = !!view.window;
// "Open that day first" and "Nearest first" stay greyed until there is a day or a position.
const sorts: { v: string; t: BiT; off?: boolean }[] = [
  { v: 'tier', t: W.sortTier },
  { v: 'name', t: W.sortName },
  { v: 'zone', t: W.sortZone },
  ...(view.costs.length ? [{ v: 'cost', t: W.sortCost }] : []),
  ...(hasDays ? [{ v: 'open', t: W.sortOpen, off: true }] : []),
  { v: 'near', t: W.sortNear, off: true },
];
---
<section class="gd-pane" id="gd-places" data-gd-pane="places" tabindex="-1" {...attr('aria-label', view.labels.items)}>
  <div class="gd-pane-bar">
    <h2><Bi t={view.labels.items} /></h2>
    <button type="button" class="gd-x" data-gd-close-pane data-js-only {...attr('aria-label', W.close)} {...attr('title', W.close)}></button>
  </div>
  <div class="gd-sortbar" data-js-only>
    <label class="gd-sort-field"><span class="gd-sort-label" set:html={biAccelHtml(W.sortBy.en, W.sortBy.zh)}></span>
      <select data-gd-sort-select accesskey="o">
        {sorts.map((o) => <option value={o.v} disabled={o.off} {...text(o.t)}>{o.t.en}</option>)}
      </select>
    </label>
    <button type="button" class="gd-sort-default" data-gd-sort-default hidden {...attr('title', W.sortDefaultTip)}><Bi t={W.sortDefault} /></button>
  </div>
  {loose.length > 0 && (
    <p class="gd-scope" data-js-only>
      <input type="checkbox" id="gd-listings" data-gd-listings />
      <label for="gd-listings"><Bi t={{ en: `${W.showListings.en} ${lowerFirst(view.labels.listings.en)} (${loose.length})`, zh: `${W.showListings.zh}${view.labels.listings.zh || view.labels.listings.en}（${loose.length}）` }} /></label>
    </p>
  )}
  <div class="gd-pane-body">
    <table class="interactive details gd-table" data-gd-table>
      <colgroup><col class="gd-c-ref" /><col /></colgroup>
      {/* Heads for screen readers: "Sort by:" above does what clicking them did. */}
      <thead class="gd-thead">
        <tr>
          <th scope="col"><span class="sr-only"><Bi t={W.ref} /></span></th>
          <th scope="col"><span class="sr-only"><Bi t={view.labels.item} /></span></th>
        </tr>
      </thead>
      {view.places.length > 0 && (
        <tbody data-gd-group="places">
          {view.places.map((p) => (
            <tr data-gd-row={p.id} data-kind="place" data-q={q(p.id, p.name, p.short, p.address, both(p.label))}>
              <td class="gd-col-ref"><span class="gd-plate" aria-hidden="true">{p.id}</span><span class="sr-only">{p.id}</span></td>
              <td class="gd-col-main"><a href={`#gd-item-${p.id}`} data-gd-sel={p.id} class="gd-row-name">{p.name}</a><span class="gd-row-sub"><Bi t={p.label} /></span></td>
            </tr>
          ))}
        </tbody>
      )}
      <tbody data-gd-group="items">
        {view.items.map((it) => (
          <tr data-gd-row={it.id} data-kind="item" data-tier={it.tier} data-zone={it.zone} data-zi={zoneAt(it.zone)} data-ci={costAt(it.cost)} data-q={q(it.id, it.name, it.short, it.subtitle, it.subtitleZh, it.by, it.address, both(zone(it.zone)), ...it.themes.map((t) => both(theme(t))), ...(awardOf(it.award) ? [both(awardOf(it.award)!.name)] : []))}>
            <td class="gd-col-ref"><span class={`ico ico16 ico-pin-${it.tier.toLowerCase()}`} aria-hidden="true"></span> {it.id}</td>
            <td class="gd-col-main">
              <a href={`#gd-item-${it.id}`} data-gd-sel={it.id} class="gd-row-name">{it.name}</a>
              {(it.by || it.subtitle) && <span class="gd-row-sub">{it.by}{it.by && it.subtitle && ' - '}{it.subtitleZh ? <Bi t={{ en: it.subtitle, zh: it.subtitleZh }} /> : it.subtitle}</span>}
              {/* The marks (distinction, price level); the day status when a day is chosen (panes.ts), else the opening days; then the area. */}
              <span class="gd-row-meta">{marks(it) && <><span class="gd-row-marks"><Bi t={marks(it)!} /></span><span class="gd-dot" aria-hidden="true">·</span></>}<span class="gd-row-day" data-gd-cell>{it.open?.length ? <Bi t={weekPattern(it.open)} /> : null}</span><span class="gd-dot" aria-hidden="true">·</span><span class="gd-row-area"><Bi t={zone(it.zone)} /></span></span>
            </td>
          </tr>
        ))}
      </tbody>
      <tbody data-gd-group="closed" hidden>
        <tr class="gd-group"><th colspan="2" scope="rowgroup" data-gd-closed-head></th></tr>
      </tbody>
      {loose.length > 0 && (
        <tbody data-gd-group="listings">
          <tr class="gd-group"><th colspan="2" scope="rowgroup"><Bi t={view.labels.listings} /></th></tr>
          {loose.map((r) => (
            <tr data-gd-row={r.id} data-kind="listing" data-q={q(r.id, r.name, r.subtitle, r.by, r.address, both(category(r.category)), both(r.about), r.details)}>
              <td class="gd-col-ref"><span class="ico ico16 ico-pin-d" aria-hidden="true"></span> {r.id}</td>
              <td class="gd-col-main">
                <a href={`#gd-item-${r.id}`} data-gd-sel={r.id} class="gd-row-name">{r.name}</a>
                {(r.by || r.subtitle) && <span class="gd-row-sub">{[r.by, r.subtitle].filter(Boolean).join(' - ')}</span>}
                {/* As an item's: the day status or the opening days, then its kind of place. */}
                <span class="gd-row-meta"><span class="gd-row-day" data-gd-cell>{r.open?.length ? <Bi t={weekPattern(r.open)} /> : null}</span><span class="gd-dot" aria-hidden="true">·</span><span class="gd-row-area"><Bi t={category(r.category)} /></span></span>
              </td>
            </tr>
          ))}
        </tbody>
      )}
    </table>
    <p class="gd-empty" data-gd-empty hidden><Bi t={W.noMatch} /> <button type="button" data-gd-clear-find><Bi t={W.clear} /></button></p>
  </div>
</section>
