---
import { home, projects } from '../lib/content';
import ResponsiveImage from './ResponsiveImage.astro';
---
<section class="project-index theme-light">
  <div class="section-bg" aria-hidden="true">
    <ResponsiveImage image={home.background} cover eager />
  </div>
  <ul class="project-list">
    {projects.map((p) => (
      <li><a href={`/image/${p.slug}`}>{p.title}</a></li>
    ))}
  </ul>
</section>
