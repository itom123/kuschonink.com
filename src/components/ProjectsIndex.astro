---
import { getImage } from 'astro:assets';
import Win98 from '../layouts/Win98.astro';
import { home, projects, imagesOf, site } from '../lib/content';
import { img } from '../lib/images';
import { roomForProject } from '../lib/house';
import Bi from '../components/Bi.astro';
import { t, attr, floorZh, seoTitle } from '../lib/i18n';
import type { Seo } from '../lib/types';

// The simple view's Projects window. Rendered at / (the default view) and /image.
interface Props { seo?: Seo }
const { seo = { ...seoTitle(t.projects, site.name), description: home.seo.description } } = Astro.props;

const items = await Promise.all(
  projects.map(async (p) => {
    const all = imagesOf(p.sections);
    const t = await getImage({ src: img(all[0]), width: 320, height: 240, fit: 'cover', format: 'webp', quality: 72 });
    const blocks = p.sections.flatMap((s) => s.blocks);
    const room = roomForProject(p.slug);
    return {
      p,
      thumb: t.src,
      images: all.length,
      texts: blocks.filter((b) => b.type === 'text' || b.type === 'marquee').length,
      videos: blocks.filter((b) => b.type === 'video').length,
      room,
      source: room?.constraints.find((c) => c.list === 'source')?.value ?? '',
      sourceZh: room?.constraints.find((c) => c.list === 'source')?.valueZh ?? '',
    };
  }),
);
---
<Win98 seo={seo} title={t.projects} address="C:\xiangyin\image" status={{ en: `${projects.length} object(s)`, zh: `${projects.length} 个对象` }}>
  <h1><Bi t={t.projects} /></h1>
  <p data-l="en">All work by {site.name}. <a href="/image/all">See every project on one page</a>, or <a href="/house/facade">walk through the house</a>.</p>
  <p data-l="zh" lang="zh-Hans">{site.name}的全部作品。<a href="/image/all">在一页上查看所有作品</a>，或者<a href="/house/facade">走进这座房子</a>。</p>

  <div class="view-switch" role="radiogroup" {...attr('aria-label', t.view)}>
    <input type="radio" name="view" id="view-icons" class="view-radio-icons" checked />
    <label for="view-icons"><Bi t={t.largeIcons} /></label>
    <input type="radio" name="view" id="view-details" class="view-radio-details" />
    <label for="view-details"><Bi t={t.details} /></label>

    <ul class="explorer view-icons">
      {items.map(({ p, thumb, images }) => (
        <li>
          <a href={`/image/${p.slug}`}>
            <img class="thumb" src={thumb} alt="" width="140" height="105" loading="lazy" />
            <span class="name"><Bi t={{ en: p.title, zh: p.titleZh ?? '' }} /></span>
            <span class="meta"><Bi t={{ en: `${images} image${images === 1 ? '' : 's'}`, zh: `${images} 张图片` }} /></span>
          </a>
        </li>
      ))}
    </ul>

    <div class="view-details sunken-panel">
      <table class="interactive details" data-sortable>
        <thead>
          <tr>
            <th data-sort="text"><Bi t={t.name} /></th>
            <th data-sort="text"><Bi t={t.room} /></th>
            <th data-sort="text"><Bi t={t.floor} /></th>
            <th data-sort="num"><Bi t={t.chapterCol} /></th>
            <th data-sort="num"><Bi t={t.images} /></th>
            <th data-sort="num"><Bi t={t.texts} /></th>
            <th data-sort="num"><Bi t={t.videos} /></th>
            <th data-sort="text"><Bi t={t.sourceDealt} /></th>
          </tr>
        </thead>
        <tbody>
          {items.map(({ p, images, texts, videos, room, source, sourceZh }) => (
            <tr>
              <td><a href={`/image/${p.slug}`}><Bi t={{ en: p.title, zh: p.titleZh ?? '' }} /></a></td>
              <td>{room ? <a href={`/house/${room.slug}`}><Bi t={{ en: room.en, zh: room.zh }} /></a> : ''}</td>
              <td>{room ? <Bi t={{ en: room.floor.name, zh: floorZh(room.floor.zh) }} /> : ''}</td>
              <td>{room?.chapter ?? ''}</td>
              <td>{images}</td>
              <td>{texts}</td>
              <td>{videos}</td>
              <td><Bi t={{ en: source, zh: sourceZh }} /></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <p class="classify-note"><small><Bi t={t.classify} /></small></p>
</Win98>

<script>
  // Click a column heading to sort, like Explorer's Details view.
  function initSort() {
  for (const table of document.querySelectorAll<HTMLTableElement>('table[data-sortable]:not([data-ready])')) {
    table.dataset.ready = '1';
    const heads = [...table.tHead!.rows[0].cells];
    heads.forEach((th, i) => {
      th.tabIndex = 0;
      const sort = () => {
        const asc = th.dataset.dir !== 'asc';
        heads.forEach((h) => delete h.dataset.dir);
        th.dataset.dir = asc ? 'asc' : 'desc';
        const num = th.dataset.sort === 'num';
        const rows = [...table.tBodies[0].rows];
        rows.sort((a, b) => {
          const text = (c: HTMLTableCellElement) => (c.querySelector(`[data-l="${document.documentElement.dataset.lang === 'zh' ? 'zh' : 'en'}"]`) ?? c).textContent!.trim();
          const x = text(a.cells[i]), y = text(b.cells[i]);
          const d = num ? Number(x) - Number(y) : x.localeCompare(y);
          return asc ? d : -d;
        });
        table.tBodies[0].append(...rows);
      };
      th.addEventListener('click', sort);
      th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sort(); } });
    });
  }
  }
  initSort();
  // Runs again when a window loads this page (see src/scripts/win98-wm.ts).
  document.addEventListener('astro:page-load', initSort);
</script>
