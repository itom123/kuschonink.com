---
import { getImage } from 'astro:assets';
import Win98 from '../layouts/Win98.astro';
import { home, projects, imagesOf, site } from '../lib/content';
import { img } from '../lib/images';
import { roomForProject } from '../lib/house';
import type { Seo } from '../lib/types';

// The simple view's Projects window. Rendered at / (the default view) and /image.
interface Props { seo?: Seo }
const { seo = { title: `Projects — ${site.name}`, description: home.seo.description } } = Astro.props;

const items = await Promise.all(
  projects.map(async (p) => {
    const all = imagesOf(p.sections);
    const t = await getImage({ src: img(all[0]), width: 320, height: 240, fit: 'cover', format: 'webp', quality: 72 });
    const blocks = p.sections.flatMap((s) => s.blocks);
    const room = roomForProject(p.slug);
    return {
      p,
      thumb: t.src,
      images: all.length,
      texts: blocks.filter((b) => b.type === 'text' || b.type === 'marquee').length,
      videos: blocks.filter((b) => b.type === 'video').length,
      room,
      source: room?.constraints.find((c) => c.list === 'source')?.value ?? '',
    };
  }),
);
---
<Win98 seo={seo} title="Projects" address="C:\kuschonink\image" status={`${projects.length} object(s)`}>
  <h1>Projects</h1>
  <p>All work by {site.name}. <a href="/image/all">See every project on one page</a>, or <a href="/house/facade">walk through the house</a>.</p>

  <div class="view-switch" role="radiogroup" aria-label="View">
    <input type="radio" name="view" id="view-icons" checked />
    <label for="view-icons">Large icons</label>
    <input type="radio" name="view" id="view-details" />
    <label for="view-details">Details</label>

    <ul class="explorer view-icons">
      {items.map(({ p, thumb, images }) => (
        <li>
          <a href={`/image/${p.slug}`}>
            <img class="thumb" src={thumb} alt="" width="140" height="105" loading="lazy" />
            <span class="name">{p.title}</span>
            <span class="meta">{images} image{images === 1 ? '' : 's'}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="view-details sunken-panel">
      <table class="interactive details" data-sortable>
        <thead>
          <tr>
            <th data-sort="text">Name</th>
            <th data-sort="text">Room</th>
            <th data-sort="text">Floor</th>
            <th data-sort="num">Chapter</th>
            <th data-sort="num">Images</th>
            <th data-sort="num">Texts</th>
            <th data-sort="num">Videos</th>
            <th data-sort="text">Source (dealt)</th>
          </tr>
        </thead>
        <tbody>
          {items.map(({ p, images, texts, videos, room, source }) => (
            <tr>
              <td><a href={`/image/${p.slug}`}>{p.title}</a></td>
              <td>{room ? <a href={`/house/${room.slug}`}>{room.en}{room.zh && ` ${room.zh}`}</a> : ''}</td>
              <td>{room?.floor.name ?? ''}</td>
              <td>{room?.chapter ?? ''}</td>
              <td>{images}</td>
              <td>{texts}</td>
              <td>{videos}</td>
              <td>{source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
  <p class="classify-note"><small>The house collects; this window classifies.</small></p>
</Win98>

<script>
  // Click a column heading to sort, like Explorer's Details view.
  for (const table of document.querySelectorAll<HTMLTableElement>('table[data-sortable]')) {
    const heads = [...table.tHead!.rows[0].cells];
    heads.forEach((th, i) => {
      th.tabIndex = 0;
      const sort = () => {
        const asc = th.dataset.dir !== 'asc';
        heads.forEach((h) => delete h.dataset.dir);
        th.dataset.dir = asc ? 'asc' : 'desc';
        const num = th.dataset.sort === 'num';
        const rows = [...table.tBodies[0].rows];
        rows.sort((a, b) => {
          const x = a.cells[i].textContent!.trim(), y = b.cells[i].textContent!.trim();
          const d = num ? Number(x) - Number(y) : x.localeCompare(y);
          return asc ? d : -d;
        });
        table.tBodies[0].append(...rows);
      };
      th.addEventListener('click', sort);
      th.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); sort(); } });
    });
  }
</script>
