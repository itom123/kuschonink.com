---
// The 中/EN switch. The choice is remembered in the browser (src/scripts/lang.ts).
---
<span class="lang-toggle" role="group" aria-label="Language · 语言">
  <button type="button" data-lang-toggle="zh" lang="zh-Hans" aria-pressed="false">中</button><span aria-hidden="true">/</span><button type="button" data-lang-toggle="en" lang="en" aria-pressed="true">EN</button>
</span>
