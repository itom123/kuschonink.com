---
import type { Block } from '../../lib/types';
import Bi from '../Bi.astro';
import Caption from '../Caption.astro';
import { attr, t } from '../../lib/i18n';
interface Props { block: Extract<Block, { type: 'video' }> }
const { block } = Astro.props;
const embed = block.youtubeId
  ? `https://www.youtube-nocookie.com/embed/${block.youtubeId}`
  : block.vimeoId
    ? `https://player.vimeo.com/video/${block.vimeoId}`
    : null;
---
<figure class="block block-video">
  {embed ? (
    <div class="video-frame">
      <iframe src={embed} {...attr('title', { en: block.caption ?? 'Video', zh: block.captionZh ?? block.caption ?? '视频' })} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  ) : (
    <a href={block.url} target="_blank" rel="noopener"><Bi t={t.watchVideo} /></a>
  )}
  <Caption text={block.caption} zh={block.captionZh} />
</figure>
