---
import type { ImageRef } from '../../lib/types';
import ResponsiveImage from '../ResponsiveImage.astro';
import Caption from '../Caption.astro';
interface Props { image: ImageRef; eager?: boolean }
const { image, eager } = Astro.props;
---
<figure class="block block-image">
  {image.link ? (
    <a href={image.link}><ResponsiveImage image={image} sizes="(max-width: 800px) 100vw, 1200px" eager={eager} /></a>
  ) : (
    <ResponsiveImage image={image} sizes="(max-width: 800px) 100vw, 1200px" eager={eager} />
  )}
  <Caption text={image.caption} zh={image.captionZh} />
</figure>
