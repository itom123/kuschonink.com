---
import { site } from '../../lib/content';
import { t, attr, type Bi as BiText } from '../../lib/i18n';
import Bi from '../Bi.astro';

interface Props {
  /** "mail": laid out as a New Message window (the Contact program); "plain": a page form (the house). */
  variant?: 'plain' | 'mail';
}
const { variant = 'plain' } = Astro.props;
const { email, form } = site.contact;
// With a Turnstile site key, the form posts to the site's Worker.
// Without one, it opens the visitor's email app with the message filled in.
// The email address itself is never shown on the page.
const live = Boolean(form.turnstileSiteKey && form.endpoint);
const MAIL_LABELS: Record<string, BiText> = {
  name: { en: 'From:', zh: '发件人：' },
  email: { en: 'E-mail:', zh: '电子邮箱：' },
  subject: { en: 'Subject:', zh: '主题：' },
};
const PLACEHOLDERS: Record<string, BiText> = {
  name: { en: 'Your name', zh: '你的名字' },
  email: { en: 'you@example.com', zh: 'you@example.com' },
  subject: { en: 'What is it about?', zh: '关于什么？' },
  message: { en: 'Write your message here.', zh: '在这里写下你的消息。' },
};
const maxlength = (name: string) => (name === 'email' ? 254 : name === 'subject' ? 180 : 120);
const autocomplete = (name: string) => (name === 'name' ? 'name' : name === 'email' ? 'email' : 'off');
const lines = form.fields.filter((f) => f.type !== 'textarea');
const bodies = form.fields.filter((f) => f.type === 'textarea');
const label = (f: (typeof form.fields)[number]): BiText => ({ en: f.label, zh: f.labelZh ?? '' });
const placeholder = (name: string) => (PLACEHOLDERS[name] ? attr('placeholder', PLACEHOLDERS[name]) : {});
---
<form
  class:list={['block', 'block-form', 'contact-form', { 'mail-form': variant === 'mail' }]}
  action={live ? form.endpoint : `mailto:${email}`}
  method="post"
  enctype={live ? undefined : 'text/plain'}
  data-email={live ? undefined : email}
  data-endpoint={live ? form.endpoint : undefined}
  data-sitekey={live ? form.turnstileSiteKey : undefined}
  data-success={form.successMessage}
  data-success-zh={form.successMessageZh}
>
  {variant === 'mail' ? (
    <>
      <div class="mail-headers">
        <div class="mail-row">
          <span class="mail-key"><Bi t={{ en: 'To:', zh: '收件人：' }} /></span>
          <span class="mail-to"><span class="ico ico16 ico-mail" aria-hidden="true"></span>{site.name}</span>
        </div>
        {lines.map((f) => (
          <label class="field mail-row">
            <span class="mail-key"><Bi t={MAIL_LABELS[f.name] ?? { en: `${f.label}:`, zh: f.labelZh ? `${f.labelZh}：` : '' }} />{f.required && <span class="sr-only"> (<Bi t={t.required} />)</span>}</span>
            <input type={f.type as "text" | "email"} name={f.name} required={f.required} maxlength={maxlength(f.name)} autocomplete={autocomplete(f.name)} {...placeholder(f.name)} />
          </label>
        ))}
      </div>
      {bodies.map((f) => (
        <label class="field mail-body">
          <span class="sr-only"><Bi t={label(f)} />{f.required && <> (<Bi t={t.required} />)</>}</span>
          <textarea name={f.name} required={f.required} rows="10" maxlength="4000" {...placeholder(f.name)}></textarea>
        </label>
      ))}
    </>
  ) : (
    form.fields.map((f) => (
      <label class="field">
        <span class="field-label"><Bi t={label(f)} />{f.required && <span class="field-required"> (<Bi t={t.required} />)</span>}</span>
        {f.type === 'textarea' ? (
          <textarea name={f.name} required={f.required} rows="6" maxlength="4000"></textarea>
        ) : (
          <input type={f.type} name={f.name} required={f.required} maxlength={maxlength(f.name)} autocomplete={autocomplete(f.name)} />
        )}
      </label>
    ))
  )}
  {/* Spam trap: people never see or fill this. */}
  <label class="field-trap" aria-hidden="true">Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  {live && <div class="turnstile"></div>}
  <div class="form-actions"><button type="submit" class:list={['button', { default: variant === 'mail' }]}><Bi t={{ en: form.submitText, zh: form.submitTextZh ?? '' }} /></button></div>
  <p class="form-status" role="status" aria-live="polite" hidden></p>
  <p class="form-success" hidden><Bi t={{ en: form.successMessage, zh: form.successMessageZh ?? '' }} /></p>
</form>
<script>
  import { formErrors } from '../../lib/i18n';
  import { pick } from '../../scripts/lang';
  type TS = { render: (el: Element, o: object) => string; reset: (id?: string) => void; remove?: (id: string) => void };
  let turnstileLoading: Promise<TS> | null = null;
  function loadTurnstile(): Promise<TS> {
    const w = window as unknown as { turnstile?: TS };
    if (w.turnstile) return Promise.resolve(w.turnstile);
    turnstileLoading ??= new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve(w.turnstile!);
      s.onerror = reject;
      document.head.appendChild(s);
    });
    return turnstileLoading;
  }

  // An unsent message is kept for this tab: a refresh, or closing the window and
  // opening it again, doesn't lose it. Sending clears it. (Never the spam trap.)
  const DRAFT = 'kus98:draft';
  const draftFields = (form: HTMLFormElement) =>
    [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input[name]:not([type="hidden"]):not([type="checkbox"]), textarea[name]')].filter((el) => el.name !== 'website');
  function readDraft(): Record<string, string> {
    try {
      const d = JSON.parse(sessionStorage.getItem(DRAFT) || '{}');
      return d && typeof d === 'object' ? d : {};
    } catch {
      return {};
    }
  }
  function writeDraft(form: HTMLFormElement) {
    const d: Record<string, string> = {};
    for (const el of draftFields(form)) if (el.value.trim()) d[el.name] = el.value;
    try {
      if (Object.keys(d).length) sessionStorage.setItem(DRAFT, JSON.stringify(d));
      else sessionStorage.removeItem(DRAFT);
    } catch { /* private mode: nothing is kept */ }
  }
  function clearDraft() {
    try { sessionStorage.removeItem(DRAFT); } catch { /* ignore */ }
  }

  /** On the desktop, results also come up as a message box. */
  function box(form: HTMLFormElement, text: string, ok: boolean) {
    window.kus98?.alert({
      title: ok ? pick({ en: 'Message sent', zh: '消息已发送' }) : pick({ en: 'Contact', zh: '联系' }),
      icon: ok ? 'info' : 'error',
      text,
      owner: form,
    });
  }

  function initForms() {
    for (const form of document.querySelectorAll<HTMLFormElement>('.contact-form:not([data-ready])')) {
      form.dataset.ready = '1';
      const status = form.querySelector<HTMLElement>('.form-status')!;
      const success = form.querySelector<HTMLElement>('.form-success')!;
      const say = (msg: string) => { status.textContent = msg; status.hidden = !msg; };
      const endpoint = form.dataset.endpoint;
      let token = '';
      let widget: string | undefined;

      // Bring back an unsent message (into empty fields only), and keep it as it's written.
      const draft = readDraft();
      for (const el of draftFields(form)) if (!el.value && typeof draft[el.name] === 'string') el.value = draft[el.name];
      form.addEventListener('input', () => writeDraft(form));

      if (endpoint && form.dataset.sitekey) {
        loadTurnstile()
          .then((ts) => {
            if (!form.isConnected) return;
            widget = ts.render(form.querySelector('.turnstile')!, {
              sitekey: form.dataset.sitekey,
              action: 'kuschonink-contact',
              callback: (t: string) => { token = t; },
              'expired-callback': () => { token = ''; },
            });
          })
          .catch(() => say(pick({ en: 'The anti-spam check could not load. Please reload the page and try again.', zh: '反垃圾验证无法加载，请刷新页面后重试。' })));
        // When its window closes, take the anti-spam widget with it.
        form.closest('[data-window]')?.addEventListener('desktop:close', () => {
          const w = window as unknown as { turnstile?: TS };
          if (widget) w.turnstile?.remove?.(widget);
        }, { once: true });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const get = (k: string) => String(data.get(k) ?? '').trim();

        if (!endpoint) {
          // Fallback: open the visitor's email app.
          const body = `${get('message')}\n\n— ${get('name')} (${get('email')})`;
          window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(get('subject'))}&body=${encodeURIComponent(body)}`;
          success.hidden = false;
          return;
        }
        if (!token) return say(pick({ en: 'Please wait for the anti-spam check to finish.', zh: '请等待反垃圾验证完成。' }));
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        say(pick({ en: 'Sending…', zh: '正在发送……' }));
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: get('name'), email: get('email'), subject: get('subject'), message: get('message'), website: get('website'), turnstileToken: token }),
          });
          if (res.ok) {
            form.reset();
            clearDraft();
            say('');
            success.hidden = false;
            form.querySelectorAll('.field, .turnstile, .form-actions, .mail-headers').forEach((el) => ((el as HTMLElement).hidden = true));
            box(form, pick({ en: form.dataset.success ?? 'Your message has been sent.', zh: form.dataset.successZh ?? '' }), true);
            return;
          }
          const err = (await res.json().catch(() => ({}))) as { error?: string; detail?: string };
          // Unknown failures show their code, so a problem can be traced.
          const code = [err.error ?? 'error', err.detail].filter(Boolean).join(': ');
          const known = formErrors[err.error ?? ''];
          const msg = known
            ? pick(known)
            : pick({
                en: `The message could not be sent (${code}, ${res.status}). Please try again later.`,
                zh: `消息未能发送（${code}，${res.status}）。请稍后再试。`,
              });
          say(msg);
          box(form, msg, false);
        } catch {
          const msg = pick({ en: 'The message could not be sent. Please try again later.', zh: '消息未能发送。请稍后再试。' });
          say(msg);
          box(form, msg, false);
        } finally {
          button.disabled = false;
          token = '';
          const w = window as unknown as { turnstile?: TS };
          if (widget) w.turnstile?.reset(widget);
        }
      });
    }
  }
  initForms();
  document.addEventListener('astro:page-load', initForms);
</script>
