---
import { site } from '../../lib/content';

interface Props {
  /** "mail": laid out as a New Message window (the Contact program); "plain": a page form (the house). */
  variant?: 'plain' | 'mail';
}
const { variant = 'plain' } = Astro.props;
const { email, form } = site.contact;
// With a Turnstile site key, the form posts to the site's Worker.
// Without one, it opens the visitor's email app with the message filled in.
const live = Boolean(form.turnstileSiteKey && form.endpoint);
const MAIL_LABELS: Record<string, string> = { name: 'From:', email: 'E-mail:', subject: 'Subject:' };
const PLACEHOLDERS: Record<string, string> = { name: 'Your name', email: 'you@example.com', subject: 'What is it about?', message: 'Write your message here.' };
const maxlength = (name: string) => (name === 'email' ? 254 : name === 'subject' ? 180 : 120);
const autocomplete = (name: string) => (name === 'name' ? 'name' : name === 'email' ? 'email' : 'off');
const lines = form.fields.filter((f) => f.type !== 'textarea');
const bodies = form.fields.filter((f) => f.type === 'textarea');
---
<form
  class:list={['block', 'block-form', 'contact-form', { 'mail-form': variant === 'mail' }]}
  action={live ? form.endpoint : `mailto:${email}`}
  method="post"
  enctype={live ? undefined : 'text/plain'}
  data-email={email}
  data-endpoint={live ? form.endpoint : undefined}
  data-sitekey={live ? form.turnstileSiteKey : undefined}
  data-success={form.successMessage}
>
  {variant === 'mail' ? (
    <>
      <div class="mail-headers">
        <div class="mail-row">
          <span class="mail-key">To:</span>
          <span class="mail-to"><span class="ico ico16 ico-mail" aria-hidden="true"></span>{site.name}</span>
        </div>
        {lines.map((f) => (
          <label class="field mail-row">
            <span class="mail-key">{MAIL_LABELS[f.name] ?? `${f.label}:`}{f.required && <span class="sr-only"> (required)</span>}</span>
            <input type={f.type as "text" | "email"} name={f.name} required={f.required} maxlength={maxlength(f.name)} autocomplete={autocomplete(f.name)} placeholder={PLACEHOLDERS[f.name]} />
          </label>
        ))}
      </div>
      {bodies.map((f) => (
        <label class="field mail-body">
          <span class="sr-only">{f.label}{f.required && ' (required)'}</span>
          <textarea name={f.name} required={f.required} rows="10" maxlength="4000" placeholder={PLACEHOLDERS[f.name]}></textarea>
        </label>
      ))}
    </>
  ) : (
    form.fields.map((f) => (
      <label class="field">
        <span class="field-label">{f.label}{f.required && <span class="field-required"> (required)</span>}</span>
        {f.type === 'textarea' ? (
          <textarea name={f.name} required={f.required} rows="6" maxlength="4000"></textarea>
        ) : (
          <input type={f.type} name={f.name} required={f.required} maxlength={maxlength(f.name)} autocomplete={autocomplete(f.name)} />
        )}
      </label>
    ))
  )}
  {/* Spam trap: people never see or fill this. */}
  <label class="field-trap" aria-hidden="true">Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  {live && <div class="turnstile"></div>}
  <div class="form-actions"><button type="submit" class:list={['button', { default: variant === 'mail' }]}>{form.submitText}</button></div>
  <p class="form-status" role="status" aria-live="polite" hidden></p>
  <p class="form-success" hidden>{form.successMessage}</p>
</form>
<script>
  const ERRORS: Record<string, string> = {
    verification_failed: 'The anti-spam check failed. Please try again.',
    rate_limited: 'Too many messages just now. Please try again later.',
    missing_required_field: 'Please fill in every field.',
    field_too_long: 'One of the fields is too long.',
    invalid_submission: 'Please check your email address.',
    delivery_in_progress: 'Your message is already on its way. Please wait a moment.',
  };
  type TS = { render: (el: Element, o: object) => string; reset: (id?: string) => void; remove?: (id: string) => void };
  let turnstileLoading: Promise<TS> | null = null;
  function loadTurnstile(): Promise<TS> {
    const w = window as unknown as { turnstile?: TS };
    if (w.turnstile) return Promise.resolve(w.turnstile);
    turnstileLoading ??= new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true;
      s.onload = () => resolve(w.turnstile!);
      s.onerror = reject;
      document.head.appendChild(s);
    });
    return turnstileLoading;
  }

  /** On the desktop, results also come up as a message box. */
  function box(form: HTMLFormElement, text: string, ok: boolean) {
    window.kus98?.alert({ title: ok ? 'Message sent' : 'Contact', icon: ok ? 'info' : 'error', text, owner: form });
  }

  function initForms() {
    for (const form of document.querySelectorAll<HTMLFormElement>('.contact-form:not([data-ready])')) {
      form.dataset.ready = '1';
      const status = form.querySelector<HTMLElement>('.form-status')!;
      const success = form.querySelector<HTMLElement>('.form-success')!;
      const say = (msg: string) => { status.textContent = msg; status.hidden = !msg; };
      const endpoint = form.dataset.endpoint;
      let token = '';
      let widget: string | undefined;

      if (endpoint && form.dataset.sitekey) {
        loadTurnstile()
          .then((ts) => {
            if (!form.isConnected) return;
            widget = ts.render(form.querySelector('.turnstile')!, {
              sitekey: form.dataset.sitekey,
              action: 'kuschonink-contact',
              callback: (t: string) => { token = t; },
              'expired-callback': () => { token = ''; },
            });
          })
          .catch(() => say('The anti-spam check could not load. You can also write to ' + form.dataset.email + '.'));
        // When its window closes, take the anti-spam widget with it.
        form.closest('[data-window]')?.addEventListener('desktop:close', () => {
          const w = window as unknown as { turnstile?: TS };
          if (widget) w.turnstile?.remove?.(widget);
        }, { once: true });
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const get = (k: string) => String(data.get(k) ?? '').trim();

        if (!endpoint) {
          // Fallback: open the visitor's email app.
          const body = `${get('message')}\n\n— ${get('name')} (${get('email')})`;
          window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(get('subject'))}&body=${encodeURIComponent(body)}`;
          success.hidden = false;
          return;
        }
        if (!token) return say('Please wait for the anti-spam check to finish.');
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        say('Sending…');
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: get('name'), email: get('email'), subject: get('subject'), message: get('message'), website: get('website'), turnstileToken: token }),
          });
          if (res.ok) {
            form.reset();
            say('');
            success.hidden = false;
            form.querySelectorAll('.field, .turnstile, .form-actions, .mail-headers').forEach((el) => ((el as HTMLElement).hidden = true));
            box(form, form.dataset.success ?? 'Your message has been sent.', true);
            return;
          }
          const err = (await res.json().catch(() => ({}))) as { error?: string; detail?: string };
          // Unknown failures show their code, so a problem can be traced.
          const code = [err.error ?? 'error', err.detail].filter(Boolean).join(': ');
          const msg = ERRORS[err.error ?? ''] ?? `The message could not be sent (${code}, ${res.status}). Please write to ${form.dataset.email}.`;
          say(msg);
          box(form, msg, false);
        } catch {
          const msg = `The message could not be sent. Please write to ${form.dataset.email}.`;
          say(msg);
          box(form, msg, false);
        } finally {
          button.disabled = false;
          token = '';
          const w = window as unknown as { turnstile?: TS };
          if (widget) w.turnstile?.reset(widget);
        }
      });
    }
  }
  initForms();
  document.addEventListener('astro:page-load', initForms);
</script>
