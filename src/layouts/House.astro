---
// The house: plain Times New Roman, early-web look.
import { ClientRouter } from 'astro:transitions';
import Base from './Base.astro';
import '../styles/blocks.css';
import '../styles/house.css';
import { site } from '../lib/content';
import Bi from '../components/Bi.astro';
import LangToggle from '../components/LangToggle.astro';
import { t } from '../lib/i18n';
import type { Seo } from '../lib/types';

interface Props { seo: Seo; image?: string; simpleHref?: string; bodyClass?: string; noindex?: boolean }
const { seo, image, simpleHref = '/image', bodyClass, noindex = false } = Astro.props;
---
<Base seo={seo} image={image} bodyClass={`house ${bodyClass ?? ''}`}>
  <ClientRouter slot="head" fallback="swap" />
  {noindex && <meta slot="head" name="robots" content="noindex, nofollow, noarchive" />}
  <header class="house-top" transition:persist="house-top">
    <a class="house-name" href="/">{site.name}</a>
    <nav>
      <a href="/house"><Bi t={t.theHouse} /></a>
      <span aria-hidden="true">|</span>
      <a href={simpleHref} data-simple-link><Bi t={t.simpleView} /></a>
      <span aria-hidden="true" class="sep-social">|</span>
      <a href={site.social[0].href} target="_blank" rel="noopener">Instagram</a>
      <span aria-hidden="true">|</span>
      <LangToggle />
    </nav>
  </header>
  <slot />
</Base>
