---
import Win98 from '../layouts/Win98.astro';
import Bi from '../components/Bi.astro';
import { site } from '../lib/content';
import { t } from '../lib/i18n';
---
<Win98 seo={{ title: `Not found — ${site.name}`, titleZh: `找不到网页 — ${site.name}` }} title={{ en: 'Error', zh: '错误' }} address="C:\kuschonink\???" status={{ en: '1 error', zh: '1 个错误' }}>
  <h1><Bi t={t.notFoundTitle} /></h1>
  <p><Bi t={t.notFoundBody} /></p>
  <ul>
    <li><a href="/house/facade"><Bi t={t.frontDoor} /></a></li>
    <li><a href="/"><Bi t={t.seeAllProjects} /></a></li>
  </ul>
  <p><small><Bi t={{ en: 'HTTP 404 — File not found', zh: 'HTTP 404 — 找不到文件' }} /></small></p>
</Win98>
