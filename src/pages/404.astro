---
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/desktop/Window.astro';
import { site } from '../lib/content';
---
<Desktop seo={{ title: `Not found — ${site.name}` }} noindex>
  <Window app="error" title="kuschonink 98" variant="error" icon="error" address={false} w={480} h={330} bodyClass="flat">
    <div class="error-page">
      <div class="msg-row">
        <span class="ico ico-error" aria-hidden="true"></span>
        <div>
          <h1 class="error-title">The page cannot be found</h1>
          <p>Cannot find '<span data-missing>C:\kuschonink\???</span>'. Make sure the path or Internet address is correct.</p>
          <p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
          <ul>
            <li><a href="/">Go to the Welcome screen</a></li>
            <li><a href="/image">See all projects</a></li>
            <li><a href="/house">Walk through the house</a></li>
          </ul>
        </div>
      </div>
      <div class="msg-buttons"><a class="button-link default" href="/" data-cmd="close">OK</a></div>
      <p class="error-code">HTTP 404 — File not found</p>
    </div>
  </Window>
</Desktop>

<script>
  const missing = 'C:\\kuschonink' + decodeURIComponent(location.pathname).replace(/\//g, '\\');
  document.querySelectorAll('[data-missing]').forEach((el) => (el.textContent = missing));
</script>
