---
import Desktop from '../../layouts/Desktop.astro';
import Window from '../../components/desktop/Window.astro';
import ProjectBody from '../../components/ProjectBody.astro';
import { projects, site, home } from '../../lib/content';
import { EXPLORER_LINKS, EXPLORER_TOOLS } from '../../lib/chrome';
---
<Desktop seo={{ title: `All projects — ${site.name}`, description: home.seo.description }}>
  <Window
    app="explorer"
    title="All projects"
    icon="documents"
    home="/image"
    address="C:\kuschonink\image\*.*"
    tools={EXPLORER_TOOLS}
    links={EXPLORER_LINKS}
    bodyClass="doc"
    status={[`${projects.length} projects`, 'Every project on one page.']}
  >
    <div class="doc-page" id="top">
      <h1>All projects</h1>
      <ol>
        {projects.map((p) => <li><a href={`#${p.slug}`}>{p.title}</a></li>)}
      </ol>
      {projects.map((p, i) => (
        <section class="project-block" id={p.slug}>
          <ProjectBody project={p} headingLevel="h2" eager={i === 0} />
          <p><a href="#top">↑ Top</a> · <a href={`/image/${p.slug}`}>Open on its own</a></p>
        </section>
      ))}
    </div>
  </Window>
</Desktop>
