---
import Win98 from '../../layouts/Win98.astro';
import ProjectBody from '../../components/ProjectBody.astro';
import Bi from '../../components/Bi.astro';
import { projects, site, home } from '../../lib/content';
import { t, seoTitle } from '../../lib/i18n';
---
<Win98 seo={{ ...seoTitle(t.allProjects, site.name), description: home.seo.description }} title={t.allProjects} address="C:\kuschonink\image\*.*" status={{ en: `${projects.length} projects`, zh: `${projects.length} 件作品` }}>
  <h1><Bi t={t.allProjects} /></h1>
  <ol>
    {projects.map((p) => <li><a href={`#${p.slug}`}><Bi t={{ en: p.title, zh: p.titleZh ?? '' }} /></a></li>)}
  </ol>
  {projects.map((p, i) => (
    <section class="project-block" id={p.slug}>
      <ProjectBody project={p} headingLevel="h2" eager={i === 0} />
      <p><a href="#top"><Bi t={t.top} /></a> · <a href={`/image/${p.slug}`}><Bi t={t.openOnItsOwn} /></a></p>
    </section>
  ))}
</Win98>
