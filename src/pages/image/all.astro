---
import Win98 from '../../layouts/Win98.astro';
import ProjectBody from '../../components/ProjectBody.astro';
import { projects, site, home } from '../../lib/content';
---
<Win98 seo={{ title: `All projects — ${site.name}`, description: home.seo.description }} title="All projects" address="C:\kuschonink\image\*.*" status={`${projects.length} projects`}>
  <h1>All projects</h1>
  <ol>
    {projects.map((p) => <li><a href={`#${p.slug}`}>{p.title}</a></li>)}
  </ol>
  {projects.map((p, i) => (
    <section class="project-block" id={p.slug}>
      <ProjectBody project={p} headingLevel="h2" eager={i === 0} />
      <p><a href="#top">↑ Top</a> · <a href={`/image/${p.slug}`}>Open on its own</a></p>
    </section>
  ))}
</Win98>
