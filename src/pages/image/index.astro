---
// The Projects folder: an Explorer window with Web View, in Thumbnails,
// List or Details view (View menu or the Views button).
import { getImage } from 'astro:assets';
import Desktop from '../../layouts/Desktop.astro';
import Window from '../../components/desktop/Window.astro';
import { home, projects, imagesOf, site } from '../../lib/content';
import { img } from '../../lib/images';
import { roomForProject } from '../../lib/house';
import { EXPLORER_LINKS, EXPLORER_TOOLS, SEP, type Tool } from '../../lib/chrome';

const plural = (n: number, one: string) => `${n} ${one}${n === 1 ? '' : 's'}`;
const items = await Promise.all(
  projects.map(async (p) => {
    const all = imagesOf(p.sections);
    const t = await getImage({ src: img(all[0]), width: 320, height: 240, fit: 'cover', format: 'webp', quality: 72 });
    const blocks = p.sections.flatMap((s) => s.blocks);
    const room = roomForProject(p.slug);
    const texts = blocks.filter((b) => b.type === 'text' || b.type === 'marquee').length;
    const videos = blocks.filter((b) => b.type === 'video').length;
    return {
      p,
      thumb: t.src,
      images: all.length,
      texts,
      videos,
      room,
      facts: [plural(all.length, 'image'), texts ? plural(texts, 'text') : '', videos ? plural(videos, 'video') : ''].filter(Boolean).join(' · '),
      where: room ? `In the house: ${room.en}${room.zh ? ' ' + room.zh : ''}, ${room.floor.name.toLowerCase()} (chapter ${room.chapter})` : '',
      source: room?.constraints.find((c) => c.list === 'source')?.value ?? '',
    };
  }),
);
const total = items.reduce((n, i) => n + i.images, 0);
const tools: Tool[] = [...EXPLORER_TOOLS, SEP, { cmd: 'views', label: 'Views', icon: 'tb-views', title: 'Thumbnails, List or Details' }];
---
<Desktop seo={{ title: `Projects — ${site.name}`, description: home.seo.description }}>
  <Window
    app="explorer"
    title="Projects"
    icon="folder-open"
    home="/image"
    tools={tools}
    links={EXPLORER_LINKS}
    bodyClass="folder-body"
    status={[`${projects.length} object(s)`, 'Double-click a project to open it.']}
  >
    <aside class="webview" slot="side" data-webview>
      <div class="wv-head"><span class="ico ico-folder-open" aria-hidden="true"></span><h2>Projects</h2></div>
      <div class="wv-rule" aria-hidden="true"></div>
      <div class="wv-default">
        <p>{projects.length} projects by {site.name}, with {total} images.</p>
        <p>Select a project to see its description. Double-click to open it.</p>
        <p><a href="/image/all">See every project on one page</a>, or <a href="/house/facade">walk through the house</a>.</p>
      </div>
      <div class="wv-item" hidden>
        <img class="wv-thumb" alt="" width="320" height="240" />
        <b class="wv-name"></b>
        <span class="wv-type">Project folder</span>
        <p class="wv-desc"></p>
        <p class="wv-facts"></p>
        <p class="wv-room"></p>
      </div>
    </aside>
    <div class="folder-page" data-folder-page data-view="thumbs">
      <h1 class="sr-only">Projects</h1>
      <ul class="projects-view" aria-label="Projects">
        {items.map(({ p, thumb, facts, where }) => (
          <li>
            <a
              class="icon"
              href={`/image/${p.slug}`}
              data-icon-id={p.slug}
              data-type="Project folder"
              data-thumb={thumb}
              data-desc={p.seo.description ?? ''}
              data-facts={facts}
              data-room={where}
              draggable="false"
            >
              <img class="thumb" src={thumb} alt="" width="140" height="105" loading="lazy" />
              <span class="ico ico16 ico-folder list-ico" aria-hidden="true"></span>
              <span class="icon-label">{p.title}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="details-view">
        <table class="interactive details" data-sortable>
          <thead>
            <tr>
              <th data-sort="text">Name</th>
              <th data-sort="text">Room</th>
              <th data-sort="text">Floor</th>
              <th data-sort="num">Chapter</th>
              <th data-sort="num">Images</th>
              <th data-sort="num">Texts</th>
              <th data-sort="num">Videos</th>
              <th data-sort="text">Source (dealt)</th>
            </tr>
          </thead>
          <tbody>
            {items.map(({ p, images, texts, videos, room, source }) => (
              <tr data-href={`/image/${p.slug}`} tabindex="-1">
                <td><span class="ico ico16 ico-folder" aria-hidden="true"></span> <a href={`/image/${p.slug}`}>{p.title}</a></td>
                <td>{room ? <a href={`/house/${room.slug}`}>{room.en}{room.zh && ` ${room.zh}`}</a> : ''}</td>
                <td>{room?.floor.name ?? ''}</td>
                <td>{room?.chapter ?? ''}</td>
                <td>{images}</td>
                <td>{texts}</td>
                <td>{videos}</td>
                <td>{source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="classify-note"><small>The house collects; this window classifies.</small></p>
    </div>
  </Window>
</Desktop>

<script>
  import { initExplorerFolder } from '../../scripts/explorer';
  initExplorerFolder();
  document.addEventListener('astro:page-load', initExplorerFolder);
</script>
