---
// The façade: the south elevation. The door and windows lead into the house.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import House from '../layouts/House.astro';
import { house, roomByKey } from '../lib/house';
import { home, site } from '../lib/content';
import Bi from '../components/Bi.astro';
import { t } from '../lib/i18n';

const drawings = import.meta.glob<ImageMetadata>('../assets/house/*.png', { eager: true, import: 'default' });
const elevation = await getImage({ src: drawings[`../assets/house/${house.elevation.src}`], width: 2400, format: 'webp' });
// Hotspot boxes are in the drawing's 1200 × 1400 coordinate space.
const view = '140 330 920 600';
---
<House seo={home.seo} bodyClass="facade-page">
  <main class="facade">
    <h1>{site.name}</h1>
    <p class="facade-hint">{t.facadeHint.en}<br /><span lang="zh">{t.facadeHint.zh}</span></p>
    <svg class="elevation" viewBox={view} role="img" aria-labelledby="elev-title">
      <title id="elev-title">{t.elevation.en} ({t.elevation.zh})</title>
      <image href={elevation.src} x="0" y="0" width="1200" height="1400" />
      {house.elevation.hotspots.map((h) => {
        const room = roomByKey.get(h.room);
        if (!room) return null;
        const [x, y, w, hh] = h.box;
        return (
          <a href={`/house/${room.slug}`} class:list={['hotspot', { door: h.label.startsWith('Front door') }]} aria-label={`${h.label} ${h.zh}: ${room.title} ${room.titleZh}`}>
            <rect x={x} y={y} width={w} height={hh} />
            <title>{h.label} {h.zh} → {room.title} {room.titleZh !== room.title ? room.titleZh : ''}</title>
          </a>
        );
      })}
    </svg>
    <p class="facade-links">
      <a href="/house/f1-porch"><Bi t={t.enterDoor} /></a>{' · '}
      <a href="/house"><Bi t={t.seePlans} /></a>{' · '}
      <a href="/image"><Bi t={t.simpleAll} /></a>
    </p>
    <hr />
    <address>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </address>
  </main>
</House>
