---
// The home page: the desktop with the Welcome window open.
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/desktop/Window.astro';
import Welcome from '../components/apps/Welcome.astro';
import { home } from '../lib/content';
---
<Desktop seo={home.seo}>
  <Window app="welcome" title="Welcome" variant="welcome" address={false} bodyClass="flat" w={680} h={470}>
    <Welcome />
  </Window>
</Desktop>
