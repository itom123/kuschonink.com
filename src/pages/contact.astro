---
import Win98 from '../layouts/Win98.astro';
import Section from '../components/Section.astro';
import { contact as page, site } from '../lib/content';
import { roomForPage } from '../lib/house';
import Bi from '../components/Bi.astro';
import { t, floorZh } from '../lib/i18n';
const room = roomForPage('contact');
---
<Win98 seo={page.seo} title={`${page.title} ${t.contact.zh}`} address={`C:\\kuschonink\\contact.txt`} houseHref={room ? `/house/${room.slug}` : '/house'} status={room ? `In the house: ${room.en}, ${room.floor.name.toLowerCase()} · 在房子里：${floorZh(room.floor.zh)}${room.zh}` : site.name}>
  <h1><Bi t={{ en: page.title, zh: t.contact.zh }} /></h1>
  {page.sections.map((s, i) => <Section section={s} first={i === 0} />)}
</Win98>
