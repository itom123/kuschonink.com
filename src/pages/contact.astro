---
import Win98 from '../layouts/Win98.astro';
import Section from '../components/Section.astro';
import { contact as page, site } from '../lib/content';
import { roomForPage } from '../lib/house';
const room = roomForPage('contact');
---
<Win98 seo={page.seo} title={page.title} address={`C:\\kuschonink\\contact.txt`} houseHref={room ? `/house/${room.slug}` : '/house'} status={room ? `In the house: ${room.en}, ${room.floor.name.toLowerCase()}` : site.name}>
  <h1>{page.title}</h1>
  {page.sections.map((s, i) => <Section section={s} first={i === 0} />)}
</Win98>
