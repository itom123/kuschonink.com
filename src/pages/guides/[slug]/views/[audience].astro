---
// Field Guide (导览): one guide, for one audience. Built as
// dist/guides/<slug>/views/<audience>.html and served only by the Worker
// (worker/guides.ts) to someone holding that audience's cookie, at
// /guides/<slug>. Everything here is already filtered for the audience
// (src/lib/guides/load.ts), the embedded JSON included.
// Without JS: one column (static map, places, every article, routes, days,
// info, a log-off form). With JS: src/scripts/guide/ makes it a program.
import Desktop from '../../../../layouts/Desktop.astro';
import Window from '../../../../components/desktop/Window.astro';
import Bi from '../../../../components/Bi.astro';
import GuideMap from '../../../../components/guide/GuideMap.astro';
import Details from '../../../../components/guide/Details.astro';
import PlacesTable from '../../../../components/guide/PlacesTable.astro';
import RoutesPane from '../../../../components/guide/RoutesPane.astro';
import DaysPane from '../../../../components/guide/DaysPane.astro';
import InfoPane from '../../../../components/guide/InfoPane.astro';
import { site } from '../../../../lib/content';
import { attr, seoTitle } from '../../../../lib/i18n';
import { SEP, type Tool } from '../../../../lib/chrome';
import { guideCards, loadView, payloadJson, viewPaths } from '../../../../lib/guides/load';
import { dayLabel } from '../../../../lib/guides/core';
import { W } from '../../../../lib/guides/words';
import { SW } from '../../../../lib/guides/suggest-words';
import suggestConfig from '../../../../content/guides/suggest.json';

export function getStaticPaths() {
  return viewPaths().map(({ slug, audience }) => ({ params: { slug, audience } }));
}

const { slug, audience } = Astro.params as { slug: string; audience: string };
const view = loadView(slug, audience);
const pub = view.publicTitle;
const url = `/guides/${slug}`;
const title = { en: `${pub.en} - Field Guide`, zh: `${pub.zh || pub.en} - 导览` };
const seo = {
  ...seoTitle({ en: `${pub.en} - Field Guide`, zh: `${pub.zh || pub.en} - 导览` }, site.name),
  description: `${pub.en}: a Field Guide on ${site.name}'s desktop.`,
  descriptionZh: `${pub.zh || pub.en}：${site.name} 桌面上的一份导览。`,
};
const hasDays = !!view.window;
const tools: Tool[] = [
  { href: '#gd-map', label: W.map.en, zh: W.map.zh, icon: 'tb-map', title: W.mapTip.en, titleZh: W.mapTip.zh },
  { href: '#gd-places', label: W.places.en, zh: W.places.zh, icon: 'tb-list', title: W.placesTip.en, titleZh: W.placesTip.zh },
  { href: '#gd-routes', label: W.routes.en, zh: W.routes.zh, icon: 'tb-route', title: W.routesTip.en, titleZh: W.routesTip.zh },
  ...(hasDays ? [{ href: '#gd-days', label: W.days.en, zh: W.days.zh, icon: 'tb-days', title: W.daysTip.en, titleZh: W.daysTip.zh }] : []),
  { href: '#gd-info', label: W.info.en, zh: W.info.zh, icon: 'tb-info', title: W.infoTip.en, titleZh: W.infoTip.zh },
  SEP,
  { cmd: 'gd-suggest', label: SW.tool.en, zh: SW.tool.zh, icon: 'tb-new', title: SW.toolTip.en, titleZh: SW.toolTip.zh },
  { cmd: 'gd-print', label: W.print.en, zh: W.print.zh, icon: 'tb-print', title: W.printTip.en, titleZh: W.printTip.zh },
];
const status = [W.hint, W.countAll(view.items.length, view.labels.items), W.loggedOnAs(view.audienceLabel)];
// File > Open Guide...: the listed guides' neutral public titles (the ones the log-on box shows
// before any password), only when there is more than one to choose from.
const cards = guideCards();
const guides = cards.length > 1
  ? cards.map((c) => ({ slug: c.slug, title: { en: c.publicTitle.en, zh: c.publicTitle.zh || c.publicTitle.en } }))
  : [];
const guidesJson = JSON.stringify(guides).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029');
const holiday = (d: string) => view.holidays.find((h) => h.date === d);
const opt = (d: string) => {
  const l = dayLabel(d), h = holiday(d);
  return h ? { en: `${l.en} - ${h.name.en}`, zh: `${l.zh} - ${h.name.zh || h.name.en}` } : l;
};
---
<Desktop seo={seo} noindex path={url}>
  <Window
    app="guide"
    variant="guide"
    address={false}
    url={url}
    title={title}
    icon="guide"
    menus={['&File', '&Edit', '&View', 'D&ays', '&Routes', '&Help']}
    tools={tools}
    status={status}
    bodyClass="gd-body flat"
  >
    <div
      class="gd"
      data-gd
      data-slug={slug}
      data-suggest-key={suggestConfig.turnstileSiteKey || undefined}
      data-view="places"
      data-detail="closed"
      data-items-en={view.labels.items.en}
      data-items-zh={view.labels.items.zh || view.labels.items.en}
      data-listings-en={view.labels.listings.en}
      data-listings-zh={view.labels.listings.zh || view.labels.listings.en}
      data-guide-en={view.title.en}
      data-guide-zh={view.title.zh || view.title.en}
      data-tz-en={view.timezoneLabel.en}
      data-tz-zh={view.timezoneLabel.zh || view.timezoneLabel.en}
    >
      <p class="gd-note" data-gd-today hidden></p>
      <form class="gd-filters" data-gd-filters data-js-only role="search">
        {hasDays && (
          <label class="gd-f gd-f-day"><span class="gd-f-label"><Bi t={W.when} /></span>
            <select data-gd-day>
              <option value="any" data-text-en={W.anyDay.en} data-text-zh={W.anyDay.zh}>{W.anyDay.en}</option>
              {view.window!.days.map((d) => <option value={d} data-text-en={opt(d).en} data-text-zh={opt(d).zh}>{opt(d).en}</option>)}
            </select>
          </label>
        )}
        {view.themes.length > 0 && (
          <label class="gd-f gd-f-theme"><span class="gd-f-label"><Bi t={W.theme} /></span>
            <select data-gd-theme-select>
              <option value="" data-text-en={W.allThemes.en} data-text-zh={W.allThemes.zh}>{W.allThemes.en}</option>
              {view.themes.map((t) => <option value={t.id} data-text-en={t.name.en} data-text-zh={t.name.zh || t.name.en}>{t.name.en}</option>)}
            </select>
          </label>
        )}
        <label class="gd-f gd-f-find"><span class="gd-f-label"><Bi t={W.find} /></span>
          <input type="search" data-gd-q autocomplete="off" spellcheck="false" {...attr('placeholder', W.findPh)} {...attr('aria-label', W.findBtn)} />
        </label>
      </form>
      <div class="gd-main">
        <PlacesTable view={view} />
        <RoutesPane view={view} />
        <DaysPane view={view} />
        <InfoPane view={view} />
        <div class="gd-mapwrap" id="gd-map" tabindex="-1">
          <GuideMap view={view} />
        </div>
        <aside class="gd-details" data-gd-details {...attr('aria-label', W.details)}>
          <div class="gd-details-bar" data-js-only>
            <b class="gd-details-title" data-gd-details-title></b>
            <button type="button" class="gd-sheet-size" data-gd-sheet-size><Bi t={W.full} /></button>
            <button type="button" class="gd-sheet-map" data-gd-sheet-map><Bi t={W.map} /></button>
            <button type="button" class="gd-x" data-gd-details-close {...attr('aria-label', W.close)} {...attr('title', W.close)}></button>
          </div>
          <div class="gd-details-body" data-gd-details-body>
            <Details view={view} />
          </div>
        </aside>
      </div>
      <script type="application/json" data-gd-data set:html={payloadJson(view)}></script>
      {guides.length > 1 && <script type="application/json" data-gd-guides set:html={guidesJson}></script>}
    </div>
  </Window>
</Desktop>

<script>
  import { initGuide } from '../../../../scripts/guide';
  import { initSuggest } from '../../../../scripts/guide/suggest';
  // Admin mode (checked on the server): Edit… on each entry, loaded only then.
  const initAdmin = () => {
    if (document.documentElement.hasAttribute('data-admin')) import('../../../../scripts/guide/admin-edit').then((m) => m.initGuideAdmin());
  };
  initGuide();
  initSuggest();
  initAdmin();
  document.addEventListener('astro:page-load', () => { initGuide(); initSuggest(); initAdmin(); });
  document.addEventListener('admin:change', initAdmin);
</script>
