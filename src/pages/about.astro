---
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/desktop/Window.astro';
import Section from '../components/Section.astro';
import { about as page, site } from '../lib/content';
import { roomForPage } from '../lib/house';
const room = roomForPage('about');
---
<Desktop seo={page.seo}>
  <Window
    app="about"
    title="About.doc"
    variant="document"
    bodyClass="doc"
    alt={room ? `/house/${room.slug}` : undefined}
    status={[room ? `In the house: ${room.en}, ${room.floor.name.toLowerCase()}` : site.name, 'Page 1']}
  >
    <div class="doc-page">
      <h1>{page.title}</h1>
      {page.sections.map((s, i) => <Section section={s} first={i === 0} />)}
    </div>
  </Window>
</Desktop>
