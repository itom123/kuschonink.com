---
// The façade: the south elevation. The door and windows lead into the house.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import House from '../../layouts/House.astro';
import { house, roomByKey } from '../../lib/house';
import { home, site } from '../../lib/content';

const drawings = import.meta.glob<ImageMetadata>('../../assets/house/*.png', { eager: true, import: 'default' });
const elevation = await getImage({ src: drawings[`../../assets/house/${house.elevation.src}`], width: 2400, format: 'webp' });
// Hotspot boxes are in the drawing's 1200 × 1400 coordinate space.
const view = '140 330 920 600';
---
<House seo={{ title: `The House — ${site.name}`, description: home.seo.description }} bodyClass="facade-page">
  <main class="facade">
    <h1>{site.name}</h1>
    <p class="facade-hint">This is a house. Knock on the door, or look through a window.</p>
    <svg class="elevation" viewBox={view} role="img" aria-labelledby="elev-title">
      <title id="elev-title">South elevation of the house (南立面图)</title>
      <image href={elevation.src} x="0" y="0" width="1200" height="1400" />
      {house.elevation.hotspots.map((h) => {
        const room = roomByKey.get(h.room);
        if (!room) return null;
        const [x, y, w, hh] = h.box;
        return (
          <a href={`/house/${room.slug}`} class:list={['hotspot', { door: h.label.startsWith('Front door') }]} aria-label={`${h.label}: ${room.title}`}>
            <rect x={x} y={y} width={w} height={hh} />
            <title>{h.label} → {room.title}</title>
          </a>
        );
      })}
    </svg>
    <p class="facade-links">
      <a href="/house/f1-porch">Enter by the front door</a> ·
      <a href="/house">See the floorplans</a> ·
      <a href="/">Simple view (all projects at once)</a>
    </p>
    <hr />
    <address>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </address>
  </main>
</House>
