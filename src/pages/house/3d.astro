---
// The house in 3D (a test): a dollhouse in the house's own colours, built from the same
// rooms as the floorplan, with the doors, stairs and stairwells traced from the drawings
// (src/content/house3d.json). "Blueprint" lays each drawing on its floor.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import House from '../../layouts/House.astro';
import Bi from '../../components/Bi.astro';
import { model3d, rooms, floors, furnitureOf } from '../../lib/house';
import { site } from '../../lib/content';
import { t, attr, seoTitle } from '../../lib/i18n';
import details from '../../content/house3d.json';

const data = model3d();
const buttons = [...data.floors].reverse();

// The drawings, placed in metres (house.json's scan rectangles).
const drawings = import.meta.glob<ImageMetadata>('../../assets/house/*.png', { eager: true, import: 'default' });
const scans = Object.fromEntries(
  await Promise.all(
    floors.map(async (f) => {
      const im = await getImage({ src: drawings[`../../assets/house/${f.scan.src}`], width: 2400, format: 'webp' });
      return [f.id, { src: im.src, x: f.scan.x / 1000, y: f.scan.y / 1000, w: f.scan.width / 1000, h: f.scan.height / 1000 }] as const;
    }),
  ),
);
// Furniture with drawers (drawers.json), in metres, in house coordinates.
const furniture = Object.fromEntries(
  rooms
    .map((r) => [r.slug, furnitureOf(r).map((f) => ({ en: f.en, zh: f.zh, drawers: f.drawers, rect: [(r.rect[0] + f.rect[0]) / 1000, (r.rect[1] + f.rect[1]) / 1000, f.rect[2] / 1000, f.rect[3] / 1000] }))] as const)
    .filter(([, list]) => list.length),
);
---
<House seo={{ ...seoTitle(t.model3d, site.name), description: t.model3dHelp.en }} noindex bodyClass="house-3d-page">
  <div class="house-3d" id="house-3d">
    <div class="h3d-stage" tabindex="0" {...attr('aria-label', t.model3dHelp)}></div>

    <div class="map-ui h3d-floors" role="toolbar" {...attr('aria-label', t.floors)}>
      {buttons.map((f, i) => (
        <button type="button" data-floor-btn={f.id} aria-pressed={String(i === 0)}
          {...attr('title', i === 0 ? t.wholeHouse : { en: f.name, zh: f.zh })}>{f.label}</button>
      ))}
    </div>
    <div class="map-ui h3d-toggles">
      <label><input type="checkbox" data-lift /> <Bi t={t.liftFloors} /></label>
      <label><input type="checkbox" data-blueprint3d /> <Bi t={t.blueprint} /></label>
    </div>
    <a class="map-ui h3d-plan" href="/house">← <Bi t={t.backToPlan} /></a>
    <p class="map-ui h3d-help"><Bi t={t.model3dHelp} /></p>

    <section class="h3d-card" hidden aria-live="polite">
      <div class="panel-bar"><span class="h3d-card-where"></span><button type="button" class="h3d-card-close" {...attr('aria-label', t.close)}>[×]</button></div>
      <div class="h3d-card-body">
        <h2 class="h3d-card-title"></h2>
        <p class="h3d-card-name"></p>
        <p class="h3d-card-links"><a class="h3d-open" href="#"><Bi t={t.openChapter} /> →</a></p>
      </div>
    </section>

    <div class="map-toast h3d-toast" role="status"></div>
    <p class="h3d-nogl" hidden><Bi t={t.noWebgl} /> <Bi t={t.noWebglWhy} /> <a href="/house"><Bi t={t.backToPlan} /></a></p>
    <p class="h3d-lost" role="alert" hidden><Bi t={t.glLost} /> <button type="button"><Bi t={t.glRetry} /></button></p>
    <noscript><p class="h3d-nogl"><Bi t={t.noWebgl} /> <a href="/house"><Bi t={t.backToPlan} /></a></p></noscript>
    <script type="application/json" id="house-3d-data" set:html={JSON.stringify({ ...data, furniture, details, scans, text: { noDoor: t.noDoorToast } })} />
  </div>
</House>

<script>
  import { start3d } from '../../scripts/house3d';
  start3d();
</script>
