---
// An unlisted page for one piece kept in a drawer. Not in the sitemap, the
// Index or the simple view; served with noindex (see public/_headers).
import House from '../../../layouts/House.astro';
import HouseMap from '../../../components/house/HouseMap.astro';
import { placements, sharedItems, pieces, roomByKey, type Placement } from '../../../lib/house';
import { projects, site } from '../../../lib/content';
import Bi from '../../../components/Bi.astro';
import { t, drawerN } from '../../../lib/i18n';

export function getStaticPaths() {
  return placements.map((p) => ({ params: { id: p.piece.id }, props: { p } }));
}
const { p } = Astro.props as { p: Placement };
const { piece, room, furniture, drawer, fulfils } = p;
const shared = sharedItems(piece).filter((s) => s.rooms.some((r) => r !== room));
const refLabel = (ref: Placement['piece']['references'][number]) => {
  if ('project' in ref) { const x = projects.find((y) => y.slug === ref.project)!; return { href: `/image/${x.slug}`, label: x.titleZh ? `${x.title} ${x.titleZh}` : x.title }; }
  if ('room' in ref) { const r = roomByKey.get(ref.room)!; return { href: `/house/${r.slug}`, label: `${r.title} ${r.titleZh !== r.title ? r.titleZh : ''} (ch. ${r.chapter})`.replace('  ', ' ') }; }
  const q = pieces.find((y) => y.id === ref.piece)!; return { href: `/house/drawer/${q.id}`, label: q.titleZh ? `${q.title} ${q.titleZh}` : q.title };
};
---
<House seo={{ title: `${piece.title}${piece.titleZh ? ' ' + piece.titleZh : ''} — ${site.name}` }} noindex bodyClass="house-map-page">
  <HouseMap current={room} />
  <aside class="room-panel" data-room-page={room.slug} aria-labelledby="room-title">
    <div class="panel-bar">
      <span>Chapter {room.chapter} · {room.en} · {furniture.en}, drawer {drawer} · <span lang="zh">第{room.chapter}章 · {room.zh} · {furniture.zh}{drawerN(drawer).zh}</span></span>
      <a class="panel-close" href={`/house/${room.slug}`} aria-label={t.closeDrawer.en} title={t.closeDrawer.zh}>[×]</a>
    </div>
    <div class="panel-body">
      <article class={`sheet sheet-${piece.object}`} data-sheet>
        <header>
          <h1 id="room-title">{piece.title}{piece.titleZh && piece.titleZh !== piece.title && <> <span lang="zh">{piece.titleZh}</span></>}</h1>
          <p class="sheet-date"><time datetime={piece.date}>{piece.date}</time>{piece.excerpt && <> · <i>{piece.excerpt}</i></>}</p>
        </header>
        <div class="prose" set:html={piece.html} />
        <footer class="sheet-footer">
          <p>Kept in the {furniture.en.toLowerCase()} ({furniture.zh}), drawer {drawer}, {room.en.toLowerCase()}, chapter {room.chapter}.
            {fulfils.length ? <> It fulfils the room’s constraints: {fulfils.map((f) => `${f.name.toLowerCase()}, “${f.value}”`).join('; ')}.</> : <> It fulfils none of the room’s constraints; it was placed by the tie rule (earliest chapter).</>}
          </p>
          <p lang="zh">存放于{room.zh}（第{room.chapter}章）的{furniture.zh}，{drawerN(drawer).zh}。
            {fulfils.length ? <>它满足了这个房间的约束：{fulfils.map((f) => `${f.nameZh}，“${f.valueZh}”`).join('；')}。</> : <>它不满足这个房间的任何约束；它是按平局规则（最早的章节）放进来的。</>}
          </p>
          {piece.references.length > 0 && (
            <p><Bi t={t.seeAlso} />: {piece.references.map((r, i) => { const l = refLabel(r); return <>{i > 0 && ', '}<a href={l.href}>{l.label}</a></>; })}.</p>
          )}
          {shared.length > 0 && (
            <p><Bi t={t.sharesWith} />: {shared.map((s, i) => <>{i > 0 && '; '}{s.item.label} <span lang="zh">{s.item.zh}</span> ({s.rooms.filter((r) => r !== room).map((r, j) => <>{j > 0 && ', '}<a href={`/house/${r.slug}`}>ch. {r.chapter}</a></>)})</>)}.</p>
          )}
        </footer>
      </article>
      <hr />
      <p><a href={`/house/${room.slug}`}>← <Bi t={t.closeDrawer} /></a></p>
    </div>
  </aside>
</House>
