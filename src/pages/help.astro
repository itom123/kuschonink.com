---
// Xiangyin 98 Help: a real page (for search engines and anyone without
// JavaScript), laid out like Windows Help: Contents / Index / Search, topics.
// Every topic is in English and Chinese; the 中/EN switch shows one.
import Desktop from '../layouts/Desktop.astro';
import Window from '../components/desktop/Window.astro';
import Bi from '../components/Bi.astro';
import helpJson from '../content/help.json';
import { site } from '../lib/content';
import { attr, seoTitle } from '../lib/i18n';
import type { Tool } from '../lib/chrome';

interface Topic { id: string; title: string; titleZh: string; icon: string; keywords: string[]; keywordsZh: string[]; html: string; htmlZh: string }
const fill = (html: string) => html.replaceAll('{email}', site.contact.email).replaceAll('{instagram}', site.social[0].href);
const topics = (helpJson as { topics: Topic[] }).topics.map((t) => ({ ...t, html: fill(t.html), htmlZh: fill(t.htmlZh) }));
const titleOf = (t: Topic) => ({ en: t.title, zh: t.titleZh });

// The Index, one per language: every keyword (and title), in order, with its topics.
function indexFor(l: 'en' | 'zh') {
  const byKey = new Map<string, Topic[]>();
  for (const t of topics) {
    for (const k of l === 'en' ? [...t.keywords, t.title] : [...t.keywordsZh, t.titleZh]) {
      const list = byKey.get(k) ?? [];
      if (!list.includes(t)) list.push(t);
      byKey.set(k, list);
    }
  }
  return [...byKey].sort((a, b) => a[0].localeCompare(b[0], l === 'en' ? 'en' : 'zh-CN', { sensitivity: 'base' }));
}
const indexes = { en: indexFor('en'), zh: indexFor('zh') };
const plain = (html: string) => html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const tools: Tool[] = [
  { cmd: 'help-hide', label: 'Hide', zh: '隐藏', icon: 'run', title: 'Hide or show the Contents', titleZh: '隐藏或显示目录' },
  { cmd: 'back', label: 'Back', zh: '后退', icon: 'tb-back' },
  { cmd: 'forward', label: 'Forward', zh: '前进', icon: 'tb-forward' },
  { cmd: 'help-print', label: 'Print', zh: '打印', icon: 'document', title: 'Print the Help', titleZh: '打印帮助' },
];
const seo = {
  ...seoTitle({ en: 'Help', zh: '帮助' }, site.name),
  description: `How to use Xiangyin 98, the website of ${site.name}: the desktop, the mouse and keyboard, windows, the projects, the house, and getting in touch.`,
  descriptionZh: `如何使用 Xiangyin 98（${site.name} 的网站）：桌面、鼠标和键盘、窗口、作品、房子，以及如何取得联系。`,
};
---
<Desktop seo={seo}>
  <Window
    app="help"
    variant="help"
    title={{ en: 'Xiangyin 98 Help', zh: 'Xiangyin 98 帮助' }}
    address={false}
    tools={tools}
    bodyClass="doc"
    status={[{ en: `${topics.length} topics`, zh: `${topics.length} 个主题` }, { en: 'Press F1 for Help at any time.', zh: '随时按 F1 键获得帮助。' }]}
  >
    <div class="help-side" slot="side" data-help-side>
      <menu role="tablist" class="help-tabs" {...attr('aria-label', { en: 'Help', zh: '帮助' })}>
        <li role="tab" aria-selected="true"><a href="#help-contents" data-tab="help-contents"><Bi t={{ en: 'Contents', zh: '目录' }} /></a></li>
        <li role="tab" aria-selected="false"><a href="#help-index" data-tab="help-index"><Bi t={{ en: 'Index', zh: '索引' }} /></a></li>
        <li role="tab" aria-selected="false"><a href="#help-search" data-tab="help-search"><Bi t={{ en: 'Search', zh: '搜索' }} /></a></li>
      </menu>
      <div class="window help-tabpanel" role="tabpanel">
        <div class="help-panel" id="help-contents">
          <ul class="tree-view">
            {topics.map((t) => <li><a href={`#${t.id}`}><span class={`ico ico16 ico-${t.icon}`} aria-hidden="true"></span><Bi t={titleOf(t)} /></a></li>)}
          </ul>
        </div>
        <div class="help-panel" id="help-index">
          {(['en', 'zh'] as const).map((l) => (
            <ul class="help-index" data-l={l} lang={l === 'zh' ? 'zh-Hans' : undefined}>
              {indexes[l].map(([k, ts]) => ts.length === 1 ? (
                <li><a href={`#${ts[0].id}`}>{k}</a></li>
              ) : (
                <li>{k}{ts.map((t) => <div class="sub"><a href={`#${t.id}`}>{l === 'en' ? t.title : t.titleZh}</a></div>)}</li>
              ))}
            </ul>
          ))}
        </div>
        <div class="help-panel" id="help-search">
          <form class="help-search-form" data-help-search>
            <label for="help-q"><Bi t={{ en: 'Type in the word(s) to search for:', zh: '键入要查找的字词：' }} /></label>
            <input id="help-q" type="search" autocomplete="off" />
            <button type="submit"><Bi t={{ en: 'List Topics', zh: '列出主题' }} /></button>
          </form>
          <ul class="help-results" aria-live="polite"><li class="help-none" hidden><Bi t={{ en: 'No topics found.', zh: '找不到主题。' }} /></li></ul>
        </div>
      </div>
    </div>
    <div class="help-topics">
      {topics.map((t) => (
        <article
          class="help-topic"
          id={t.id}
          data-search-en={`${t.title} ${t.keywords.join(' ')} ${plain(t.html)}`.toLowerCase()}
          data-search-zh={`${t.titleZh} ${t.keywordsZh.join(' ')} ${plain(t.htmlZh)}`.toLowerCase()}
        >
          <h2><span class={`ico ico-${t.icon}`} aria-hidden="true"></span><Bi t={titleOf(t)} /></h2>
          <div data-l="en" set:html={t.html} />
          <div data-l="zh" lang="zh-Hans" set:html={t.htmlZh} />
        </article>
      ))}
    </div>
  </Window>
</Desktop>

<script>
  // Tabs, Search, Hide and Print for the Help window.
  function initHelp() {
    for (const side of document.querySelectorAll<HTMLElement>('[data-help-side]:not([data-ready])')) {
      side.dataset.ready = '1';
      const win = side.closest<HTMLElement>('[data-window]')!;
      const tabs = [...side.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
      const panels = [...side.querySelectorAll<HTMLElement>('.help-panel')];
      const show = (id: string) => {
        panels.forEach((p) => (p.hidden = p.id !== id));
        tabs.forEach((t) => t.parentElement!.setAttribute('aria-selected', String(t.dataset.tab === id)));
      };
      show('help-contents');
      tabs.forEach((t) => t.addEventListener('click', (e) => {
        e.preventDefault();
        show(t.dataset.tab!);
        if (t.dataset.tab === 'help-search') side.querySelector<HTMLInputElement>('#help-q')?.focus();
      }));

      const form = side.querySelector<HTMLFormElement>('[data-help-search]')!;
      const results = side.querySelector<HTMLElement>('.help-results')!;
      const none = side.querySelector<HTMLElement>('.help-none')!;
      const topics = [...win.querySelectorAll<HTMLElement>('.help-topic')];
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        // Words in either language find a topic; its title follows the 中/EN switch.
        const words = (form.querySelector('input')!.value.toLowerCase().match(/[\p{L}\p{N}+-]+/gu) ?? []);
        const hits = words.length ? topics.filter((t) => words.every((w) => `${t.dataset.searchEn} ${t.dataset.searchZh}`.includes(w))) : [];
        results.querySelectorAll('li:not(.help-none)').forEach((li) => li.remove());
        none.hidden = !words.length || hits.length > 0;
        for (const t of hits) {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${t.id}`;
          a.append(...[...t.querySelector('h2')!.childNodes].filter((n) => !(n instanceof Element && n.classList.contains('ico'))).map((n) => n.cloneNode(true)));
          li.append(a);
          results.append(li);
        }
      });

      win.addEventListener('click', (e) => {
        const c = (e.target as Element).closest<HTMLElement>('[data-cmd]');
        if (c?.dataset.cmd === 'help-hide') win.classList.toggle('help-hidden-side');
        if (c?.dataset.cmd === 'help-print') window.print();
      });

      // Highlight the topic in Contents as it scrolls into view.
      const body = win.querySelector<HTMLElement>('[data-window-body]');
      const links = new Map([...side.querySelectorAll<HTMLAnchorElement>('#help-contents a')].map((a) => [a.hash.slice(1), a]));
      if (body && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) {
            if (!en.isIntersecting) continue;
            links.forEach((a, id) => a.classList.toggle('current', id === en.target.id));
          }
        }, { root: body, rootMargin: '0px 0px -70% 0px' });
        topics.forEach((t) => io.observe(t));
        win.addEventListener('desktop:close', () => io.disconnect(), { once: true });
      }
    }
  }
  initHelp();
  document.addEventListener('astro:page-load', initHelp);
</script>
