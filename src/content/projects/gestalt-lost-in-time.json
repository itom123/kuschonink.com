        {
          "type": "text",
          "html": "<h1 class=\"align-center\">It’s okay to grasp, but don’t hold on too tightly.</h1>",
          "htmlZh": "<h1 class=\"align-center\">可以抓住，但别握得太紧。</h1>"
        },
