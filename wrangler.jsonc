{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuschonink",
  "compatibility_date": "2026-10-01",
  // Static site (dist/) served by Cloudflare. The Worker only runs for the
  // contact form endpoints (worker/contact.ts, worker/drawing.ts) and for the
  // Field Guide on /guides and /guides/* (worker/guides.ts): the password gate,
  // /guides going straight to the first listed guide, and the street-level map
  // tiles a guide's readers get (Plan IGN, fetched by the Worker and kept at the edge).
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/v1/contact/*", "/guides", "/guides/*"]
  },
  // Contact form email: can only ever send to this one verified inbox.
  "send_email": [
    { "name": "EMAIL", "destination_address": "Xiangyin.Tom.Gu@gmail.com" }
  ],
  // At most 5 messages a minute from one visitor; at most 30 Field Guide
  // password tries a minute from one visitor (a class on one Wi-Fi fits); at
  // most 600 street-level tiles a minute fetched from IGN for one visitor
  // (tiles already at the edge are not counted).
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "4242", "simple": { "limit": 5, "period": 60 } },
    { "name": "GUIDES_LIMIT", "namespace_id": "4243", "simple": { "limit": 30, "period": 60 } },
    { "name": "GUIDES_TILE_LIMIT", "namespace_id": "4245", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": { "CONTACT_TO": "Xiangyin.Tom.Gu@gmail.com" },
  // Secrets, set in the dashboard (never in this file): TURNSTILE_SECRET, and
  // each Field Guide audience's password, named in
  // src/content/guides/access.json: GUIDES_PASSWORD (visitors) and
  // GUIDES_PASSWORD_FOTOFILMIC (participants). Each password needs 6+
  // characters, and the two must differ. GUIDES_COOKIE_SECRET is recommended:
  // 32+ random characters that sign the log-on cookies; without it the Worker
  // uses TURNSTILE_SECRET, and one under 24 characters signs together with
  // TURNSTILE_SECRET. Changing GUIDES_COOKIE_SECRET logs everyone out; so does
  // changing TURNSTILE_SECRET unless GUIDES_COOKIE_SECRET has 24+ characters.
  // No "secrets.required": it would limit what wrangler dev reads from .dev.vars.
  "observability": { "enabled": true }
}
