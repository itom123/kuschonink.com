{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuschonink",
  "compatibility_date": "2026-10-01",
  // Static site (dist/) served by Cloudflare. The Worker only runs for the
  // contact form endpoints (worker/contact.ts, worker/drawing.ts) and for the
  // Field Guide's password gate on /guides/* (worker/guides.ts) and its
  // suggestions (worker/suggest.ts); the home /guides stays a plain public
  // page. Its crons publish approved suggestions (worker/publish.ts) and keep
  // contact details only as long as promised (worker/privacy.ts).
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/v1/contact/*", "/guides/*"]
  },
  // Contact form email: can only ever send to this one verified inbox.
  "send_email": [
    { "name": "EMAIL", "destination_address": "Xiangyin.Tom.Gu@gmail.com" }
  ],
  // At most 5 messages a minute from one visitor; at most 30 Field Guide
  // password tries a minute from one visitor (a class on one Wi-Fi fits).
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "4242", "simple": { "limit": 5, "period": 60 } },
    { "name": "GUIDES_LIMIT", "namespace_id": "4243", "simple": { "limit": 30, "period": 60 } },
    // At most 3 suggestions a minute from one visitor (the Guard also counts 10 an hour, and 60 in all).
    { "name": "SUGGEST_LIMIT", "namespace_id": "4244", "simple": { "limit": 3, "period": 60 } }
  ],
  // The Guard (worker/guard.ts): true counters, held keys, admin sessions and
  // locks, in one SQLite Durable Object.
  "durable_objects": { "bindings": [{ "name": "GUARD", "class_name": "Guard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Guard"] }],
  // Every 10 minutes: publish READY suggestions. Daily at 03:17 UTC: tidy the
  // Guard, and delete contact details that are due.
  "triggers": { "crons": ["*/10 * * * *", "17 3 * * *"] },
  "vars": {
    "CONTACT_TO": "Xiangyin.Tom.Gu@gmail.com",
    // The repository the publisher commits to.
    "GITHUB_REPO": "itom123/kuschonink.com",
    // Field Guide suggestions: the Notion data sources (ids, not secrets) in the
    // page "Field Guide suggestions (kuschonink)". Without NOTION_TOKEN, or with
    // these empty, suggestions go to the owner by email instead.
    "NOTION_SUGGESTIONS": "bbadd739-bc27-4d32-af25-83d05a11fcbe",
    "NOTION_CONTACTS": "24e16407-40ea-4a3f-b1a1-a8d3159c36f1",
    "NOTION_LOG": "93ccb58c-07d5-435d-ba01-cef829ea5c5e"
  },
  // Secrets, set in the dashboard (never in this file): TURNSTILE_SECRET, and
  // each Field Guide audience's password, named in
  // src/content/guides/access.json: GUIDES_PASSWORD (visitors) and
  // GUIDES_PASSWORD_FOTOFILMIC (participants). Each password needs 6+
  // characters, and the two must differ. GUIDES_COOKIE_SECRET is recommended:
  // 32+ random characters that sign the log-on cookies; without it the Worker
  // uses TURNSTILE_SECRET. Changing either secret logs everyone out.
  // Field Guide suggestions: NOTION_TOKEN (the site's Notion integration),
  // TURNSTILE_SECRET_SUGGEST (the suggestion form's own Turnstile widget) and
  // GITHUB_TOKEN (fine-grained, this repository only, Contents read/write) for
  // the publisher. See docs/GUIDES.md, "Suggestions". No "secrets.required":
  // it would limit what wrangler dev reads from .dev.vars.
  "observability": { "enabled": true }
}
