{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kuschonink",
  "compatibility_date": "2026-10-01",
  // Static site (dist/) served by Cloudflare. The Worker only runs for the
  // contact form endpoints (worker/contact.ts, worker/drawing.ts) and for the
  // Field Guide's password gate on /guides/* (worker/guides.ts); the home
  // /guides stays a plain public page.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/v1/contact/*", "/guides/*"]
  },
  // Contact form email: can only ever send to this one verified inbox.
  "send_email": [
    { "name": "EMAIL", "destination_address": "Xiangyin.Tom.Gu@gmail.com" }
  ],
  // At most 5 messages a minute from one visitor; at most 30 Field Guide
  // password tries a minute from one visitor (a class on one Wi-Fi fits).
  "ratelimits": [
    { "name": "CONTACT_LIMIT", "namespace_id": "4242", "simple": { "limit": 5, "period": 60 } },
    { "name": "GUIDES_LIMIT", "namespace_id": "4243", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "CONTACT_TO": "Xiangyin.Tom.Gu@gmail.com" },
  // Secrets, set in the dashboard (never in this file): TURNSTILE_SECRET, and
  // each Field Guide audience's password, named in
  // src/content/guides/access.json: GUIDES_PASSWORD (visitors) and
  // GUIDES_PASSWORD_FOTOFILMIC (participants). Each password needs 6+
  // characters, and the two must differ. GUIDES_COOKIE_SECRET is recommended:
  // 32+ random characters that sign the log-on cookies; without it the Worker
  // uses TURNSTILE_SECRET. Changing either secret logs everyone out. No
  // "secrets.required": it would limit what wrangler dev reads from .dev.vars.
  "observability": { "enabled": true }
}
